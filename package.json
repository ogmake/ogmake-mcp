{
  "name": "ogmake-mcp",
  "version": "0.1.2",
  "description": "Local stdio MCP server for ogmake.com og:image generation.",
  "type": "module",
  "bin": {
    "ogmake-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "pack": "npm run build && mkdir -p pack-out && npm pack --pack-destination ./pack-out",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^2.1.9",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  },
  "license": "MIT",
  "author": "ogmake",
  "mcpName": "com.ogmake/mcp",
  "homepage": "https://ogmake.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogmake/ogmake-mcp.git"
  },
  "bugs": {
    "email": "support@ogmake.com"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "og-image",
    "open-graph",
    "ogmake",
    "claude"
  ]
}
